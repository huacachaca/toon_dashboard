# Toon address reachable from the container host/network.
TOON_HOST=<<ipaddress>>

# Published/container port for the dashboard.
TOON_PORT=<<port>>

# Production host paths for the TLS certificate and private key.
# Override these on a development machine with local certificate files.
TOON_TLS_CERTFILE=<<certificate>>
TOON_TLS_KEYFILE=<<certificate_key>>

# Parser/source settings.
TOON_ELECTRICITY_COUNTER_DIVISOR=1000
TOON_GAS_COUNTER_DIVISOR=1000
TOON_TIMEZONE=Europe/Amsterdam

# Solar advice defaults.
TOON_SOLAR_PANEL_NAME=JA Solar JAM54D41-455/LB
TOON_PANEL_WP=455
TOON_SOLAR_PANEL_YEARLY_YIELD_KWH=
TOON_SPECIFIC_YIELD_KWH_PER_KWP=880
TOON_PANEL_AREA_M2=1.998
TOON_SOLAR_TARGET_PERCENT=75

# First month of the annual electricity/gas contract period (1-12).
TOON_CONTRACT_START_MONTH=8

# Forecast meter-counter baselines. Set these for your installation.
TOON_FORECAST_ELECTRICITY_TN_BASE=0
TOON_FORECAST_ELECTRICITY_TL_BASE=0
TOON_FORECAST_GAS_BASE=0
TOON_FORECAST_BASE_DATE=2026-08-01

TOON_REFRESH_TIMEOUT_SECONDS=30
